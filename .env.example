# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env.local and fill in real values
# NEVER commit .env or .env.local to git (they are gitignored)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# MONGODB_URI is the Vercel-standard env var name; the app reads this at runtime.
# DATABASE_URL is used by the Prisma CLI (prisma generate, db push, studio).
# Both should point at the same MongoDB Atlas cluster.
# Include the database name in the URI: …mongodb.net/<dbname>?…
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate a secure random secret:  openssl rand -base64 32
AUTH_SECRET="<your-random-32-byte-base64-secret>"

# Local dev URL — NOT required in Vercel (NextAuth reads VERCEL_URL automatically)
AUTH_URL="http://localhost:3000"

# ─── Microsoft Entra ID (Azure AD) SSO ─────────────────────────────────────────
# Single-tenant org login. From Azure → Entra Admin Center → App registrations.
# The ISSUER must be the tenant-specific v2.0 endpoint (NOT /common) so only your
# organisation's accounts can sign in. Callback URL to register in Azure:
#   http://localhost:3000/api/auth/callback/microsoft-entra-id   (local)
#   https://<prod-domain>/api/auth/callback/microsoft-entra-id   (production)
AUTH_MICROSOFT_ENTRA_ID_ID="<Application (client) ID>"
AUTH_MICROSOFT_ENTRA_ID_SECRET="<Client secret VALUE (not the secret ID)>"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Used by the signIn callback to reject other tenants / personal accounts.
MICROSOFT_TENANT_ID="<Directory (tenant) ID>"

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
# Create a free account at https://cloudinary.com
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_CLOUD_NAME="<cloud_name>"
CLOUDINARY_API_KEY="<api_key>"
CLOUDINARY_API_SECRET="<api_secret>"

# ─── Required Vercel environment variables ────────────────────────────────────
# Set these in your Vercel project dashboard → Settings → Environment Variables:
#
#   MONGODB_URI          ← MongoDB Atlas connection string (with database name)
#   AUTH_SECRET          ← Random 32-byte secret (openssl rand -base64 32)
#   CLOUDINARY_CLOUD_NAME
#   CLOUDINARY_API_KEY
#   CLOUDINARY_API_SECRET
#
# OPTIONAL in Vercel (auto-detected):
#   AUTH_URL             ← Vercel sets VERCEL_URL; NextAuth reads it automatically

# ─── Blog scheduler (Vercel Cron) ────────────────────────────────────────────
# Optional but recommended in production. When set, /api/cron/publish-scheduled
# requires `Authorization: Bearer <CRON_SECRET>`. Vercel Cron sends this header
# automatically when CRON_SECRET is defined in the project's env vars.
# Generate one with:  openssl rand -base64 32
CRON_SECRET=***

# ─── SEO / indexing ──────────────────────────────────────────────────────────
# No env var is needed for indexing. Public pages are indexable by default, and
# "only production (clarant.ai) may be indexed" is enforced automatically by
# HOST: middleware.ts adds `X-Robots-Tag: noindex, nofollow` on every other host
# (QA / UAT / preview / localhost), and app/robots.ts blocks crawling there too.
# (The former NEXT_PUBLIC_ALLOW_INDEXING flag is no longer read — safe to remove.)
