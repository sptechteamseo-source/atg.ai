# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# webpack build cache — large, build-time only, breaks Azure Files rsync
.next/cache
.next/cache/**

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — block real secrets but allow the example template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / editor / agent config (never push to Azure repo)
.claude/
.vscode/
.idea/
*.code-workspace

# runtime user uploads (served from Cloudinary; not source)
/public/uploads/

# secrets / keys / certs (belt-and-suspenders alongside .env*)
*.key
*.cert
*.crt
*.p12
*.pfx
secrets.json
.env.production
.env.development

# logs & OS files
*.log
logs/
Thumbs.db
ehthumbs.db
Desktop.ini

# Azure deployment artifacts
.deployment.local
*.publishsettings
*.pubxml
*.pubxml.user
